pipeline {
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-17'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }

    }

    stages{
        stage ('checkout') {
            steps {
                sh 'echo "Clone the github repo"'
                git 'https://github.com/Thomasvincent03/handson_java.git'
                sh 'ls -lrt'
            }
        }

        stage ('Build & Test') {
            steps {
                sh 'mvn clean install'
                sh 'ls -lrt target/'
            }
        }

        stage ('Create Docker Image') {
            environment {
                DockerIMG = 'thomasvincent03/simply-java:${BUILD_NUMBER}'
            }
            steps{
                sh 'docker build -t ${DockerIMG} .'
                sh 'docker images'
            }
        }
    }
}
